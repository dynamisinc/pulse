<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pulse load-test harness (post-demo-feedback/01, #547, PDF-D2). A console app that drives real participant logins,
    real SignalR connections and controller-as-persona writes against ONE throwaway "Load test" exercise, and writes
    CSV + JSON results. See README.md for the Saturday runbook.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <IsPackable>false</IsPackable>
    <RootNamespace>Pulse.LoadTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same major as the server's in-box ASP.NET Core 10 SignalR; 10.0.13 is the latest 10.0 patch: 10.0.10 pulls SignalR.Common with advisory GHSA-334f-vvp4-7g6p. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulse.LoadTest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="loadtest.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
