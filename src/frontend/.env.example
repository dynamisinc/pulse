# Copy to .env and adjust for your environment.

# Base URL of the Pulse backend API (staff consoles, feed ingestion).
# Leave blank to point the shared axios client at same-origin `/api`.
#
# A blank value does NOT by itself enable mock data. Mock data is served when
# the app runs on the Vite dev server (`npm run dev`) OR when VITE_USE_MOCK_DATA
# is explicitly `true` (see below). Otherwise a production build fails closed and
# renders blank until a real backend answers `/api/*` — deliberate (COR-001): a
# prod build must never fail open to canned exercise data.
VITE_API_URL=

# Opt-in: serve mock data from a PRODUCTION build (e.g. the backend-less UAT
# environment). Set to `true` to render every surface from canned mock data with
# no backend. Leave blank/unset everywhere else — absence fails closed, so a real
# participant-facing deploy that omits this never serves mock data.
# NEVER set this to `true` in a participant-facing production environment.
VITE_USE_MOCK_DATA=
