# Copy to .env and adjust for your environment.

# Base URL of the Pulse backend API (staff consoles, feed ingestion).
# Leave blank to point the shared axios client at same-origin `/api`.
#
# NOTE: a blank value does NOT enable mock data. The mock seams (exercise
# context, shell state, session, alerts, …) are gated on the Vite DEV build
# (`import.meta.env.DEV`), not on this variable — run `npm run dev` to work
# against mock data. A production build (`vite build` / `vite preview`) fails
# closed until a real backend answers `/api/*`, so those surfaces render blank
# without one. This is deliberate (COR-001): a prod build must never fail open
# to canned exercise data.
VITE_API_URL=
